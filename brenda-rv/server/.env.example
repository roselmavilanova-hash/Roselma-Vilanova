# ==============================================================================
# Brenda RV — variáveis de ambiente
# Copie este arquivo para `.env` e preencha. NUNCA versione o `.env` real.
# ==============================================================================

# --- Servidor -----------------------------------------------------------------
PORT=3000
# Segredo simples para proteger rotas administrativas (ex.: retomar após Sabrina).
ADMIN_TOKEN=troque-por-um-segredo-forte

# --- Meta WhatsApp Cloud API --------------------------------------------------
# Token de verificação que VOCÊ inventa e repete no painel da Meta ao assinar o webhook.
META_VERIFY_TOKEN=troque-por-um-token-de-verificacao
# App Secret do app da Meta (usado para validar a assinatura X-Hub-Signature-256).
META_APP_SECRET=
# Token de acesso permanente do WhatsApp Business (Bearer).
WHATSAPP_TOKEN=
# ID do número de telefone (Phone Number ID) no WhatsApp Business.
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API.
GRAPH_API_VERSION=v21.0

# --- Anthropic (Claude 3.5 Sonnet) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024

# --- Prompt / Fonte Oficial ---------------------------------------------------
# Caminhos (relativos à pasta do servidor) do agente e da fonte oficial.
BRENDA_AGENT_MD=../../.claude/agents/brenda-rv.md
BRENDA_FONTE_OFICIAL_MD=../FONTE-OFICIAL.md

# --- Pix estático -------------------------------------------------------------
# Chave Pix (copia-e-cola) e nome do recebedor exibido à paciente.
PIX_KEY=
PIX_RECEBEDOR=RV - Engenharia da Face
# Cidade do recebedor (para conferência).
PIX_CIDADE=Fortaleza
# ATENÇÃO: chave estática NÃO confirma pagamento automaticamente.
# Confirmação é sempre humana (Sabrina). Print de comprovante não confirma.

# --- Sabrina (alertas / supervisão humana) ------------------------------------
# Número (formato internacional, só dígitos, ex.: 5585999999999) que recebe os
# alertas de transferência. Se vazio, o alerta é apenas registrado no log.
SABRINA_WHATSAPP=
